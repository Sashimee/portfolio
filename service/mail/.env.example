# Configuration du service de courriel — copier en `.env` et remplir.
# `src/config.js` vérifie ces variables au démarrage : une seule manquante
# arrête le conteneur, en la nommant.

# --- reCAPTCHA v3 ---------------------------------------------------------
# La clé PUBLIQUE correspondante est dans src/boot/recap.js, côté SPA.
# Le secret vivait dans le service disparu avec bask.lu : s'il est
# introuvable, régénérer la paire sur https://www.google.com/recaptcha/admin
# et reporter la clé publique dans le boot du front.
RECAPTCHA_SECRET=
# Facultatif — 0.5 par défaut. Plus haut, on refuse des humains.
# RECAPTCHA_SCORE_MIN=0.5

# --- SMTP (relais partagé de la machine) ----------------------------------
# `mailrelay` (boky/postfix) tourne déjà sur l'hôte et sert Aura. Depuis
# `dokploy-network`, il n'exige **aucune authentification** : le sous-réseau
# overlay tombe dans son `mynetworks`. C'est lui qui s'authentifie auprès
# d'OVH, comme `info@bas.lu`, et il accepte le domaine `bas.lu` en expéditeur.
#
# Laisser SMTP_USER et SMTP_PASSWORD vides : la clé `auth` est alors omise.
# Les remplir tous les deux — jamais un seul — pour viser un SMTP classique
# (`ssl0.ovh.net`, port 465).
SMTP_HOST=mailrelay
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Courriel -------------------------------------------------------------
# MAIL_FROM doit être un expéditeur que le relais a le droit d'émettre, donc
# une adresse @bas.lu. L'adresse du visiteur part en Reply-To, jamais en From.
#
# Si OVH refuse l'envoi (il demande parfois que l'enveloppe corresponde à la
# boîte authentifiée), le repli est `info@bas.lu` — même relais, aucun
# changement côté serveur.
MAIL_FROM=portfolio@bas.lu
MAIL_TO=
# MAIL_SUBJECT_PREFIX=[portfolio]

# --- Réseau ---------------------------------------------------------------
# PORT=3000
# ALLOWED_ORIGINS=https://alex.baskewitsch.lu
# Mettre à true derrière Traefik, et seulement là : sinon n'importe qui
# choisit son compteur de débit en forgeant X-Forwarded-For.
TRUST_PROXY=true
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=5
